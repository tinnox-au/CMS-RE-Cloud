# TINNOX CMS prototype M0 - environment variables.
# Do not copy this file by hand: `npm run setup` writes a gitignored .env with random
# development secrets. This file only documents each variable. Values here are placeholders.
# In production NODE_ENV=production start-up must refuse: any secret starting with "dev-",
# an http:// issuer or origin, non-Secure cookies, and the tinnox-dev realm (D19).

NODE_ENV=development
# pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- PostgreSQL -------------------------------------------------------------
# Host port for the Docker PostgreSQL (bound to 127.0.0.1). Default 54329; setup picks the
# next free port if it is taken.
POSTGRES_HOST_PORT=54329
# Superuser password; used only by the container's first-run initialisation.
POSTGRES_SUPERUSER_PASSWORD=change-me
# Role that owns the schema and runs migrations. Never used by the running API.
TINNOX_MIGRATOR_PASSWORD=change-me
# Runtime role: NOSUPERUSER, NOBYPASSRLS, owns no tables.
TINNOX_APP_PASSWORD=change-me
# API runtime connection (role tinnox_app).
DATABASE_URL=postgres://tinnox_app:change-me@127.0.0.1:54329/tinnox
# Migrations and seed only (role tinnox_migrator).
DATABASE_MIGRATOR_URL=postgres://tinnox_migrator:change-me@127.0.0.1:54329/tinnox
# Integration tests use a separate database that is dropped and re-created on every run.
TEST_DATABASE_URL=postgres://tinnox_app:change-me@127.0.0.1:54329/tinnox_test
TEST_DATABASE_MIGRATOR_URL=postgres://tinnox_migrator:change-me@127.0.0.1:54329/tinnox_test

# --- API --------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=4000
# Origin players use to reach the API; also the base of signed media URLs.
API_PUBLIC_ORIGIN=http://localhost:4000
# Exact origins. PORTAL_ORIGIN is the only origin accepted for cookie-authenticated
# state-changing requests; PLAYER_ORIGIN is the only CORS origin, and only for /player/*.
PORTAL_ORIGIN=http://localhost:5173
PLAYER_ORIGIN=http://localhost:5174
# At least 32 random bytes. Reserved for signing/derivation by the session layer.
SESSION_SECRET=change-me
# Absolute session lifetime and idle timeout.
SESSION_TTL_SECONDS=28800
SESSION_IDLE_TIMEOUT_SECONDS=1800
# HMAC key for short-lived player media URLs. At least 32 random bytes.
MEDIA_URL_HMAC_SECRET=change-me
# HMAC key used to turn a client address into the pairing rate-limit key, so raw
# addresses are not stored.
PAIRING_CLIENT_KEY_SECRET=change-me

# --- Identity provider (OIDC) -------------------------------------------------
OIDC_ISSUER=http://localhost:8080/realms/tinnox-dev
OIDC_CLIENT_ID=tinnox-portal-bff
OIDC_CLIENT_SECRET=change-me
# Must match a redirect URI registered for the client exactly.
OIDC_REDIRECT_URI=http://localhost:5173/api/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
# Local Keycloak admin console account (development container only).
KC_BOOTSTRAP_ADMIN_USERNAME=dev-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me

# --- Development identities ---------------------------------------------------
# OIDC subject ("sub") of the seeded operator. `npm run db:seed` creates the membership
# that links this subject to the organisation "TINNOX Internal".
DEV_OPERATOR_OIDC_SUB=00000000-0000-4000-8000-000000000000
# Subject of the second test user; `npm run db:seed -- --second-org` links it to a
# separate organisation used only by isolation tests.
DEV_SECOND_ORG_OIDC_SUB=00000000-0000-4000-8000-000000000001

# --- Media --------------------------------------------------------------------
# Private media store. Must be outside any served or source directory.
MEDIA_ROOT=./data/media
# Exchange directory shared with the isolated validation worker (inbox/ and outbox/).
MEDIA_JOBS_DIR=./data/jobs

# --- Limits (optional; defaults shown, see docs/prototype-m0.md section 6) ------
# LIMIT_MAX_UPLOAD_BYTES=209715200
# LIMIT_MAX_IMAGE_SIDE_PX=8192
# LIMIT_MAX_IMAGE_PIXELS=40000000
# LIMIT_MAX_VIDEO_WIDTH_PX=3840
# LIMIT_MAX_VIDEO_HEIGHT_PX=2160
# LIMIT_MAX_VIDEO_DURATION_MS=600000
# LIMIT_MIN_IMAGE_ITEM_DURATION_MS=1000
# LIMIT_MAX_IMAGE_ITEM_DURATION_MS=3600000
# LIMIT_MIN_CANVAS_SIDE_PX=16
# LIMIT_MAX_CANVAS_SIDE_PX=16384
# LIMIT_MAX_ORG_STORAGE_BYTES=5368709120
# LIMIT_MAX_PLAYLIST_ITEMS=200
# LIMIT_PAIRING_CODE_TTL_SECONDS=600
# LIMIT_PAIRING_MAX_WRONG_ATTEMPTS=5
# LIMIT_PAIRING_MAX_SESSIONS_PER_IP=10
# LIMIT_PAIRING_SESSION_WINDOW_SECONDS=600
# LIMIT_MEDIA_URL_TTL_SECONDS=300
# LIMIT_HEARTBEAT_INTERVAL_SECONDS=15
# LIMIT_HEARTBEAT_STALE_AFTER_SECONDS=60
# LIMIT_HEARTBEAT_LOG_RETENTION_HOURS=24
# LIMIT_MEDIA_INSPECTION_TIMEOUT_MS=30000
